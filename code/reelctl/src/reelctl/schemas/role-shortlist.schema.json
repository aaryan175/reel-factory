{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Machine-only reference-role shortlist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "method",
    "warning",
    "source_count",
    "role_count",
    "top_n",
    "roles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "MACHINE_SHORTLIST_REVIEW_REQUIRED"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "warning": {
      "type": "string",
      "minLength": 1
    },
    "source_count": {
      "type": "integer",
      "minimum": 1
    },
    "role_count": {
      "type": "integer",
      "minimum": 1
    },
    "top_n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/role"
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blueprint",
        "blueprint_sha256",
        "catalog",
        "catalog_sha256",
        "features",
        "features_sha256"
      ],
      "properties": {
        "blueprint": {
          "type": "string",
          "minLength": 1
        },
        "blueprint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "catalog": {
          "type": "string",
          "minLength": 1
        },
        "catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "features": {
          "type": [
            "string",
            "null"
          ]
        },
        "features_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "recipe_hash": {
      "$ref": "#/$defs/sha256"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reelctl_version",
        "retrieval_module_sha256",
        "role_shortlist_schema_sha256"
      ],
      "properties": {
        "reelctl_version": {
          "type": "string",
          "minLength": 1
        },
        "retrieval_module_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "role_shortlist_schema_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "target_frames",
        "substitute_requirements",
        "manual_reject_checks",
        "candidates"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/nullableString"
        },
        "target_frames": {
          "type": "array",
          "prefixItems": [
            {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "substitute_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manual_reject_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "clip_id",
        "source_path",
        "source_sha256",
        "duration_s",
        "orientation",
        "coverage_board",
        "families",
        "labels",
        "machine_score",
        "score_evidence",
        "manual_review_status"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "clip_id": {
          "$ref": "#/$defs/nullableString"
        },
        "source_path": {
          "$ref": "#/$defs/nullableString"
        },
        "source_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "orientation": {
          "$ref": "#/$defs/nullableString"
        },
        "coverage_board": {
          "$ref": "#/$defs/nullableString"
        },
        "families": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "machine_score": {
          "type": "number"
        },
        "score_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manual_review_status": {
          "const": "NOT_REVIEWED"
        }
      }
    }
  }
}
