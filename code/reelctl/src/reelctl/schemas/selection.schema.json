{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.reelctl/schemas/selection.schema.json",
  "title": "locked source selection",
  "$defs": {
    "metrics": {
      "type": "object",
      "properties": {
        "y_q10": {"type": "number"},
        "y_q50": {"type": "number"},
        "y_q90": {"type": "number"},
        "saturation_mean": {"type": "number"},
        "shadow_coverage": {"type": "number"},
        "highlight_coverage": {"type": "number"}
      },
      "additionalProperties": false
    },
    "creative": {
      "type": "object",
      "properties": {
        "exposure_stops": {"type": "number", "minimum": -1.5, "maximum": 1.0},
        "contrast": {"type": "number", "minimum": 0.75, "maximum": 1.3},
        "saturation": {"type": "number", "minimum": 0.75, "maximum": 1.3},
        "gamma": {"type": "number", "minimum": 0.8, "maximum": 1.2}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema_version", "status", "slots"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["DRAFT", "LOCKED_TO_INVENTORY", "PASS"]},
    "inventory_recipe_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "block_id",
          "frames",
          "reference_role",
          "candidate_observation",
          "source_path",
          "source_start_frame",
          "speed",
          "reverse",
          "input_profile",
          "input_range",
          "profile_proof",
          "technical_transform",
          "creative",
          "lighting_family",
          "grade_proof"
        ],
        "properties": {
          "block_id": {"type": "string", "pattern": "^p[0-9]{3,}$"},
          "frames": {"type": "integer", "minimum": 1},
          "reference_role": {"type": "string", "minLength": 1},
          "candidate_observation": {"type": "string", "minLength": 1},
          "source_path": {"type": "string", "minLength": 1},
          "source_start_frame": {"type": "integer", "minimum": 0},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_bytes": {"type": "integer", "minimum": 1},
          "source_clip_id": {"type": "string", "minLength": 1},
          "source_frame_count": {"type": "integer", "minimum": 1},
          "source_fps": {"type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"},
          "speed": {"const": 1.0},
          "reverse": {"const": false},
          "crop_anchor_xy": {
            "type": "array",
            "prefixItems": [
              {"type": "number", "minimum": 0, "maximum": 1},
              {"type": "number", "minimum": 0, "maximum": 1}
            ],
            "items": false
          },
          "display_crop_anchor_xy": {
            "type": "array",
            "prefixItems": [
              {"type": "number", "minimum": 0, "maximum": 1},
              {"type": "number", "minimum": 0, "maximum": 1}
            ],
            "items": false
          },
          "transform": {
            "type": "object",
            "properties": {"hflip": {"type": "boolean"}},
            "additionalProperties": false
          },
          "input_profile": {
            "enum": [
              "rec709",
              "sony_slog3_sgamut3cine",
              "sony_slog3_sgamut3",
              "arri_logc3_awg3",
              "canon_clog3_cinemagamut",
              "dji_dlogm_dgamut",
              "panasonic_vlog_vgamut",
              "custom_log"
              ,"PENDING_PROFILE_IDENTIFICATION"
            ]
          },
          "input_range": {"enum": ["full", "tv"]},
          "profile_proof": {
            "type": "object",
            "required": ["schema_version", "status", "method", "source_sha256", "input_range", "evidence", "signature"],
            "properties": {
              "schema_version": {"const": 1},
              "status": {"enum": ["AGENT_VERIFIED"]},
              "method": {"type": "string"},
              "source_path": {"type": "string"},
              "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "device_model": {"type": ["string", "null"]},
              "capture_gamma": {"type": "string"},
              "capture_primaries": {"type": "string"},
              "coding_equations": {"type": "string"},
              "input_range": {"enum": ["full", "tv"]},
              "container_color_range": {"enum": ["pc", "tv"]},
              "pixel_format": {"type": ["string", "null"]},
              "evidence": {"type": "string", "minLength": 1},
              "evidence_path": {"type": "string"},
              "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "signature": {"type": "object"}
            },
            "additionalProperties": false
          },
          "technical_transform": {"type": "string", "minLength": 1},
          "technical_lut": {"type": "string", "minLength": 1},
          "technical_lut_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "lighting_family": {"type": "string", "minLength": 1},
          "creative": {"$ref": "#/$defs/creative"},
          "grade_proof": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {"enum": ["PENDING_SOURCE_AWARE_GRADE_REVIEW", "PENDING_AGENT_REVIEW", "AGENT_REVIEWED", "PASS"]},
              "block_id": {"type": "string"},
              "reference_frame": {"type": "integer", "minimum": 0},
              "source_frame": {"type": "integer", "minimum": 0},
              "source_sample": {"type": "string"},
              "source_sample_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "reference_sample": {"type": "string"},
              "reference_sample_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "source_metrics": {"$ref": "#/$defs/metrics"},
              "target_metrics": {"$ref": "#/$defs/metrics"},
              "bounded_proposal": {"$ref": "#/$defs/creative"},
              "review_notes": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
